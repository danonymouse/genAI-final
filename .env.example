# All optional. Without LLM_BASE_URL the service serves cached / lexicon explanations.
# Any OpenAI-compatible endpoint; Ollama shown. From inside Docker use host.docker.internal.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=qwen3.5:9b
LLM_TIMEOUT=120
# auto | live | cache | offline
EXPLAIN_MODE=auto
RETRIEVAL_THRESHOLD=0.6
CONTRAST_THRESHOLD=2.0
